{
	"name": "a2ui-svelte",
	"version": "0.1.0",
	"description": "A2UI (Agent-to-UI) protocol renderer for Svelte 5. Runes-native. Renders agent-authored declarative UI from a locked component catalog.",
	"license": "Apache-2.0",
	"type": "module",
	"keywords": [
		"a2ui",
		"ag-ui",
		"generative-ui",
		"genui",
		"svelte",
		"sveltekit",
		"agent",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChaliceForAuri/a2ui-svelte.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./protocol": {
			"types": "./dist/protocol/index.d.ts",
			"svelte": "./dist/protocol/index.js",
			"default": "./dist/protocol/index.js"
		},
		"./transport": {
			"types": "./dist/transport/index.d.ts",
			"svelte": "./dist/transport/index.js",
			"default": "./dist/transport/index.js"
		},
		"./catalog/basic": {
			"types": "./dist/catalog/basic/index.d.ts",
			"svelte": "./dist/catalog/basic/index.js",
			"default": "./dist/catalog/basic/index.js"
		},
		"./theme.css": "./dist/catalog/basic/theme.css",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": "^5.55.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.49.5",
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^24.13.3",
		"prettier": "^3.4.0",
		"prettier-plugin-svelte": "^3.3.0",
		"publint": "^0.3.0",
		"svelte": "^5.55.7",
		"svelte-check": "^4.1.0",
		"typescript": "^5.6.0",
		"vite": "^6.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --experimental-strip-types --import ./tests/register-hook.mjs --test tests/*.test.ts",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	}
}
